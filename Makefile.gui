# ATHENA Platform Browser - GUI Makefile
# Dear ImGui + GLFW + OpenGL3
#
# Usage:
#   make -f Makefile.gui          - Build GUI browser
#   make -f Makefile.gui clean    - Remove build artifacts
#   make -f Makefile.gui run      - Build and run
#
# Requirements:
#   - C++17 compiler
#   - GLFW3 (libglfw3-dev on Ubuntu, glfw on macOS/brew)
#   - OpenGL 3.3+
#
# SPDX-License-Identifier: Proprietary
# Copyright (c) 2026 ATHENA Project

# =============================================================================
# Compiler Settings
# =============================================================================

CXX := g++
CXXFLAGS := -std=c++17 -Wall -Wextra -O2
INCLUDES := -I include -I external/imgui

# =============================================================================
# Platform Detection
# =============================================================================

UNAME_S := $(shell uname -s)

ifeq ($(UNAME_S),Linux)
    # Linux
    TARGET := athena-gui
    LIBS := -lglfw -lGL -ldl -lpthread
    CXXFLAGS += -DIMGUI_IMPL_OPENGL_LOADER_GL3W
endif

ifeq ($(UNAME_S),Darwin)
    # macOS
    TARGET := athena-gui
    LIBS := -lglfw -framework OpenGL -framework Cocoa -framework IOKit -framework CoreVideo
    CXXFLAGS += -DIMGUI_IMPL_OPENGL_LOADER_GL3W
    # Homebrew paths
    INCLUDES += -I/opt/homebrew/include -I/usr/local/include
    LDFLAGS := -L/opt/homebrew/lib -L/usr/local/lib
endif

ifeq ($(OS),Windows_NT)
    # Windows (MinGW)
    TARGET := athena-gui.exe
    LIBS := -lglfw3 -lopengl32 -lgdi32 -limm32
    CXXFLAGS += -DIMGUI_IMPL_OPENGL_LOADER_GL3W
endif

# =============================================================================
# Source Files
# =============================================================================

# Dear ImGui sources
IMGUI_DIR := external/imgui
IMGUI_SRCS := \
    $(IMGUI_DIR)/imgui.cpp \
    $(IMGUI_DIR)/imgui_draw.cpp \
    $(IMGUI_DIR)/imgui_tables.cpp \
    $(IMGUI_DIR)/imgui_widgets.cpp \
    $(IMGUI_DIR)/imgui_impl_glfw.cpp \
    $(IMGUI_DIR)/imgui_impl_opengl3.cpp

# ATHENA GUI sources
GUI_SRCS := \
    src/gui/browser.cpp \
    src/gui/gui_main.cpp

# ATHENA Core sources
CORE_SRCS := \
    src/platform_loader.cpp \
    src/json.cpp

# All sources
SRCS := $(IMGUI_SRCS) $(GUI_SRCS) $(CORE_SRCS)
OBJS := $(SRCS:.cpp=.o)

# =============================================================================
# Build Rules
# =============================================================================

.PHONY: all clean run debug release check-deps

all: check-deps $(TARGET)

# Check dependencies
check-deps:
	@echo "Checking dependencies..."
	@pkg-config --exists glfw3 2>/dev/null || (echo "Error: GLFW3 not found. Install with:" && \
		echo "  Ubuntu/Debian: sudo apt install libglfw3-dev" && \
		echo "  macOS:         brew install glfw" && \
		echo "  Windows:       Download from glfw.org" && exit 1)
	@echo "Dependencies OK"

# Link
$(TARGET): $(OBJS)
	@echo "Linking $@..."
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $^ $(LIBS)
	@echo "Build complete: $@"

# Compile ATHENA sources
src/%.o: src/%.cpp
	@echo "Compiling $<..."
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c -o $@ $<

# Compile ImGui sources
$(IMGUI_DIR)/%.o: $(IMGUI_DIR)/%.cpp
	@echo "Compiling $<..."
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c -o $@ $<

# =============================================================================
# Dependencies
# =============================================================================

src/gui/browser.o: include/athena/gui/browser.hpp include/athena/platform_loader.hpp
src/gui/gui_main.o: include/athena/gui/browser.hpp
src/platform_loader.o: include/athena/platform_loader.hpp include/athena/json.hpp
src/json.o: include/athena/json.hpp

$(IMGUI_DIR)/imgui.o: $(IMGUI_DIR)/imgui.h $(IMGUI_DIR)/imgui_internal.h
$(IMGUI_DIR)/imgui_impl_glfw.o: $(IMGUI_DIR)/imgui_impl_glfw.h
$(IMGUI_DIR)/imgui_impl_opengl3.o: $(IMGUI_DIR)/imgui_impl_opengl3.h

# =============================================================================
# Utility Targets
# =============================================================================

clean:
	@echo "Cleaning..."
	rm -f $(OBJS) $(TARGET)
	@echo "Clean complete"

run: $(TARGET)
	./$(TARGET) data/platforms

# Debug build
debug: CXXFLAGS += -g -O0 -DDEBUG
debug: clean all

# Release build  
release: CXXFLAGS += -O3 -DNDEBUG
release: clean all

# =============================================================================
# Help
# =============================================================================

help:
	@echo "ATHENA GUI Browser - Build System"
	@echo ""
	@echo "Targets:"
	@echo "  all       - Build the GUI browser (default)"
	@echo "  clean     - Remove build artifacts"
	@echo "  run       - Build and run"
	@echo "  debug     - Debug build with symbols"
	@echo "  release   - Optimized release build"
	@echo "  help      - Show this help"
	@echo ""
	@echo "Requirements:"
	@echo "  - C++17 compiler (GCC 7+, Clang 5+, MSVC 2017+)"
	@echo "  - GLFW3 library"
	@echo "  - OpenGL 3.3+ support"
